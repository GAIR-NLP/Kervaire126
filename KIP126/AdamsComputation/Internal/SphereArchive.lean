private theorem archiveMonomialTable_count (s t : ℕ) :
    (archiveMonomialTable.monomials s t).length = basisCount s t := by
  rw [BasisTable.monomials_length]
  rfl

set_option backward.privateInPublic true in
private noncomputable def basisMonomialImplementation (s t : ℕ) (i : Fin (basisCount s t)) :
    SourceMonomial generators s t :=
  (archiveMonomialTable.monomials s t)[i.val]'(by
    rw [archiveMonomialTable_count]
    exact i.isLt)


