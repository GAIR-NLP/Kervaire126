module

public import KIP126.AdamsSynthetic.SpectrumScope

@[expose] section

/-! Adams objects and the sphere, Hopf-cofiber and pointed-detector instances.
The auxiliary maps and the identifications and properties of the auxiliary
objects are specified separately. The Hopf cofiber and its cell maps are
induced by the specified ν map. -/
namespace KIP126.Kervaire.Route
open CategoryTheory CategoryTheory.Pretriangulated KIP126.StableHomotopy KIP126.Synthetic.Context
universe u v w
variable {C : Type u} [StableHomotopyCategory.{u, v} C]
  {coefficients : ModTwoCoefficients C}

public structure AuxiliaryData (C : Type u) [StableHomotopyCategory.{u, v} C]
    {coefficients : ModTwoCoefficients C} where
  /-- The classical η map used by the generalized Leibniz rule.
  Its identification with h₁ and with synthetic η is specified separately. -/
  etaMap : Sphere (C := C) 1 ⟶ SphereSpectrum
  /-- The classical Hopf map, with its h₂ detection specified separately. -/
  nuMap : Sphere (C := C) 3 ⟶ SphereSpectrum
  /-- In the paper this pointed detecting spectrum is tmf. -/
  detector : C
  detectorUnit : SphereSpectrum ⟶ detector

/-- The sphere, Hopf cofiber and pointed detector, closed under integer suspension. -/
public inductive ClassicalObject
  | sphere
  | nuCofiber
  | detector
  | shift (n : ℤ) (X : ClassicalObject)

public noncomputable def ClassicalObject.obj [HasFunctorialCofiber (C := C)]
    (A : AuxiliaryData C (coefficients := coefficients)) : ClassicalObject → C
  | .sphere => SphereSpectrum
  | .nuCofiber => HasFunctorialCofiber.cofib A.nuMap
  | .detector => A.detector
  | .shift n X => (shiftFunctor C n).obj (X.obj A)

/-- Object expressions for every bounded-below finite-mod-two-type spectrum,
including the named sphere, Hopf-cofiber and detector instances. -/
public inductive AdamsObject {C : Type u} [StableHomotopyCategory.{u, v} C]
    {coefficients : ModTwoCoefficients C}
  | selected (X : ClassicalObject)
  | spectrum (X : C) (hX : KIP126.AdamsSynthetic.IsBoundedBelowFiniteModTwoType coefficients X)
  | shift (n : ℤ) (X : AdamsObject (coefficients := coefficients))

namespace AdamsObject
public abbrev sphere : AdamsObject (coefficients := coefficients) := .selected .sphere
public abbrev nuCofiber : AdamsObject (coefficients := coefficients) := .selected .nuCofiber
public abbrev detector : AdamsObject (coefficients := coefficients) := .selected .detector
public instance : Coe ClassicalObject (AdamsObject (coefficients := coefficients)) := ⟨.selected⟩

public noncomputable def obj [HasFunctorialCofiber (C := C)]
    (A : AuxiliaryData C (coefficients := coefficients)) :
    AdamsObject (coefficients := coefficients) → C
  | .selected X => X.obj A
  | .spectrum X _ => X
  | .shift n X => (shiftFunctor C n).obj (X.obj A)
end AdamsObject

/-- The object closure generated by shifts and quotients for normalized maps, finite
λ/ρ/δ triangles and the untruncated argument. -/
public inductive SyntheticObject {C : Type u} [StableHomotopyCategory.{u, v} C]
    {coefficients : ModTwoCoefficients C}
  | sphere
  | nu (X : AdamsObject (coefficients := coefficients))
  | shift (p : ℤ × ℤ) (X : SyntheticObject (coefficients := coefficients))
  | quotient (n : ℕ) (X : SyntheticObject (coefficients := coefficients))

public noncomputable def SyntheticObject.obj [HasFunctorialCofiber (C := C)]
    {Syn : Type w} [SyntheticCategory.{w, v} Syn] [HasFunctorialCofiber (C := Syn)]
    (N : NuFunctorData C Syn) (A : AuxiliaryData C (coefficients := coefficients)) : SyntheticObject (coefficients := coefficients) → Syn
  | .sphere => S_0_0
  | .nu X => N.functor.obj (X.obj A)
  | .shift p X => (SyntheticCategory.biShift p).obj (X.obj N A)
  | .quotient n X => XModLambdaN (X.obj N A) n

/-- A distinguished triangle on arbitrary objects of the Adams range.
The connecting map lands in the actual suspension of X. -/
public structure TriangleData [HasFunctorialCofiber (C := C)] (A : AuxiliaryData C (coefficients := coefficients)) where
  X : AdamsObject (coefficients := coefficients)
  Y : AdamsObject (coefficients := coefficients)
  Z : AdamsObject (coefficients := coefficients)
  f : X.obj A ⟶ Y.obj A
  g : Y.obj A ⟶ Z.obj A
  h : Z.obj A ⟶ (AdamsObject.shift 1 X).obj A
  distinguished : CategoryTheory.Pretriangulated.Triangle.mk f g h ∈
    distTriang C

/-- Distinguished triangles on the sphere, Hopf-cofiber and detector object range. -/
public structure SelectedTriangleData [HasFunctorialCofiber (C := C)]
    (A : AuxiliaryData C (coefficients := coefficients)) where
  X : ClassicalObject
  Y : ClassicalObject
  Z : ClassicalObject
  f : X.obj A ⟶ Y.obj A
  g : Y.obj A ⟶ Z.obj A
  h : Z.obj A ⟶ (ClassicalObject.shift 1 X).obj A
  distinguished : CategoryTheory.Pretriangulated.Triangle.mk f g h ∈ distTriang C

public def SelectedTriangleData.toTriangleData [HasFunctorialCofiber (C := C)]
    {A : AuxiliaryData C (coefficients := coefficients)} (T : SelectedTriangleData A) : TriangleData A where
  X := T.X
  Y := T.Y
  Z := T.Z
  f := T.f
  g := T.g
  h := T.h
  distinguished := T.distinguished

public instance [HasFunctorialCofiber (C := C)] {A : AuxiliaryData C (coefficients := coefficients)} :
    Coe (SelectedTriangleData A) (TriangleData A) := ⟨SelectedTriangleData.toTriangleData⟩

/-- The specific triangle used in the ν-extension argument. Neither its
cofiber nor its bottom/top cell maps are independent choices. -/
public noncomputable def AuxiliaryData.nuRouteTriangle [HasFunctorialCofiber (C := C)]
    (A : AuxiliaryData C (coefficients := coefficients)) : TriangleData A where
  X := .shift 3 .sphere
  Y := .sphere
  Z := .nuCofiber
  f := A.nuMap
  g := HasFunctorialCofiber.cofibι A.nuMap
  h := HasFunctorialCofiber.cofibδ A.nuMap
  distinguished := HasFunctorialCofiber.cofib_distinguished A.nuMap
end KIP126.Kervaire.Route
